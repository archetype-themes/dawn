{% style %}
  :root {
    --color-primary: rgba(var(--color-foreground));
    --color-secondary: rgb(var(--color-background));

    --layout-section-max-inline-size: 110rem;
    --layout-section-px--xs: 1.5rem;
    --layout-section-px--md: 5rem;

    --button-radius: 0;

    --heading-font-family: var(--font-heading-family);
    --heading-font-family-fallback: 'sans-serif';
    --heading-font-weight: var(--font-heading-weight);
    --heading-letter-spacing: calc(var(--font-heading-scale) * 0.06rem);

    --heading-2xl-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-xl-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-lg-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-md-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-sm-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-xs-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));

    --heading-2xl-font-size: calc(var(--font-heading-scale) * var(--text-size-10));
    --heading-xl-font-size: calc(var(--font-heading-scale) * var(--text-size-7-5));
    --heading-lg-font-size: calc(var(--font-heading-scale) * var(--text-size-5));
    --heading-md-font-size: calc(var(--font-heading-scale) * 1.7);
    --heading-sm-font-size: calc(var(--font-heading-scale) * 1.5);
    --heading-xs-font-size: calc(var(--font-heading-scale) * var(--text-size-3));

    @media ({% render 'utility.breakpoint', size: 'md' %}) {
      --heading-2xl-font-size: calc(var(--font-heading-scale) * 5.2rem);
      --heading-xl-font-size: calc(var(--font-heading-scale) * 4rem);
      --heading-lg-font-size: calc(var(--font-heading-scale) * 2.4);
      --heading-md-font-size: calc(var(--font-heading-scale) * 1.8rem);
      --heading-sm-font-size: calc(var(--font-heading-scale) * 1.5);
      --heading-xs-font-size: calc(var(--font-heading-scale) * 1.2);
    }
  }
{% endstyle %}

{% capture product_images %}
  {% for image in product.images %}
    {% render 'element.image',
      img: image,
      style: 'width: 100%; height: auto;'
    %}
  {% endfor %}
{% endcapture %}

{% capture product_images_stack %}
  {% render 'layout.stack', gap: 'md', slot: product_images %}
{% endcapture %}

{% capture product_form %}
  {%- unless product.has_only_default_variant -%}
    {% for option in product.options_with_values %}
      <fieldset>
        {% render 'element.text', as: 'legend', variant: 'body', text: option.name %}

        {% capture option_values %}
          {% for value in option.values %}
            {% unless value.available %}
              {%- assign classlist = 'disabled' -%}
            {% else %}
              {%- assign classlist = '' -%}
            {% endunless %}

            {%- capture input_id -%}
              {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
            {%- endcapture -%}

            {% assign input_value = value | escape %}

            {%- capture input_label -%}
              {% if value.swatch %}
                {%- render 'element.swatch', swatch: value.swatch, large: true, selected: value.selected -%}
              {% else %}
                {%- render 'element.button', as: 'span', text: value, inverted: true, selected: value.selected -%}
              {% endif %}
            {%- endcapture -%}

            {%- capture input_attributes -%}
              data-product-url="{{ value.product_url }}"
              data-option-value-id="{{ value.id }}"
            {%- endcapture -%}

            {%- render 'element.radio',
              id: input_id,
              name: option.name,
              value: input_value,
              label: input_label,
              checked: value.selected,
              display_icon: false,
              classlist: classlist,
              attributes: input_attributes
            -%}
          {% endfor %}
        {% endcapture %}

        {% render 'layout.stack', horizontal: true, gap: 'xs', slot: option_values %}
      </fieldset>
    {% endfor %}
  {%- endunless -%}

  {% if product.selected_or_first_available_variant.available %}
    {% render 'element.button', text: 'Add to Cart', type: 'submit', full: true %}
  {% else %}
    {% render 'element.button', text: 'Sold Out', type: 'submit', full: true, disabled: true %}
  {% endif %}
{% endcapture %}

{% capture product_form_stack %}
  {% render 'layout.stack', gap: 'md', slot: product_form %}
{% endcapture %}

{% capture product_details %}
  {% render 'element.text', as: 'h1', variant: 'heading-xl', text: product.title %}
  {% render 'element.price', price: product.price %}
  {% render 'form.product', product: product, slot: product_form_stack %}
  {% render 'element.text', variant: 'rte', text: product.description %}
{% endcapture %}

{% capture product_details_stack %}
  {% render 'layout.stack', gap: 'md', slot: product_details %}
{% endcapture %}

{% capture grid_content %}
  {{ product_images_stack }}
  {{ product_details_stack }}
{% endcapture %}

{% capture grid %}
  {% render 'layout.grid',
    columns_xs: 1,
    columns_md: 2,
    slot: grid_content,
    gap: 'md'
  %}
{% endcapture %}

<section-main-product data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  {% render 'layout.section', slot: grid %}
</section-main-product>

{% javascript %}
  function onVariantChange(event) {
    const optionValueElement = event.target;
    const productFormElement = optionValueElement.closest('form');
    const productElement = optionValueElement.closest('section-main-product');
    const sectionId = productElement.dataset.sectionId;

    // Combined listings: We use old and new product urls to determine if the product should change
    const oldProductUrl = productElement.dataset.productUrl;
    const newProductUrl = optionValueElement.dataset.productUrl;

    // Get the selected option value IDs and format as query param
    const selectedOptionValues = Array.from(productFormElement.querySelectorAll('fieldset input:checked')).map(
      ({ dataset }) => dataset.optionValueId
    );
    const params = selectedOptionValues.length > 0 ? `&option_values=${selectedOptionValues.join(',')}` : '';

    // Deferred variants: Fetch the option value picker with the new availability state when remaining on the same product
    // Combined listings: Fetch the product associated with the selected option value and replace the entire product if switching to a sibling product
    fetch(`${newProductUrl}?section_id=${sectionId}${params}`)
      .then((response) => response.text())
      .then((responseText) => {
        const html = new DOMParser().parseFromString(responseText, 'text/html');

        // Combined listings: If the product changed, replace the old product section with the new product section
        if (newProductUrl && oldProductUrl !== newProductUrl) {
          productElement.parentNode.insertBefore(html.querySelector('section-main-product'), productElement);
          productElement.remove();

          // Focus the input for the last clicked option value
          document.querySelector(`#${event.target.id}`).focus();

          return;
        }

        productFormElement.innerHTML = html.querySelector('form').innerHTML;
        document.querySelector(`#${event.target.id}`).focus();

        // Update any other sections that depend on the option value picker
      });
  }

  document.addEventListener('change', onVariantChange);
{% endjavascript %}
