{% style %}
  :root {
    --color-primary: rgba(var(--color-foreground));
    --color-secondary: rgb(var(--color-background));

    --layout-section-max-inline-size: 110rem;
    --layout-section-px--xs: 1.5rem;
    --layout-section-px--md: 5rem;

    --button-radius: 0;

    --heading-font-family: var(--font-heading-family);
    --heading-font-family-fallback: 'sans-serif';
    --heading-font-weight: var(--font-heading-weight);
    --heading-letter-spacing: calc(var(--font-heading-scale) * 0.06rem);

    --heading-2xl-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-xl-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-lg-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-md-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-sm-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    --heading-xs-line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));

    --heading-2xl-font-size: calc(var(--font-heading-scale) * var(--text-size-10));
    --heading-xl-font-size: calc(var(--font-heading-scale) * var(--text-size-7-5));
    --heading-lg-font-size: calc(var(--font-heading-scale) * var(--text-size-5));
    --heading-md-font-size: calc(var(--font-heading-scale) * 1.7);
    --heading-sm-font-size: calc(var(--font-heading-scale) * 1.5);
    --heading-xs-font-size: calc(var(--font-heading-scale) * var(--text-size-3));

    @media ({% render 'utility.breakpoint', size: 'md' %}) {
      --heading-2xl-font-size: calc(var(--font-heading-scale) * 5.2rem);
      --heading-xl-font-size: calc(var(--font-heading-scale) * 4rem);
      --heading-lg-font-size: calc(var(--font-heading-scale) * 2.4);
      --heading-md-font-size: calc(var(--font-heading-scale) * 1.8rem);
      --heading-sm-font-size: calc(var(--font-heading-scale) * 1.5);
      --heading-xs-font-size: calc(var(--font-heading-scale) * 1.2);
    }
  }
{% endstyle %}

{% capture product_images %}
  {% for image in product.images %}
    {% render 'element.image',
      img: image,
      style: 'width: 100%; height: auto;'
    %}
  {% endfor %}
{% endcapture %}

{% capture product_images_stack %}
  {% render 'layout.stack', direction: 'column', gap: 'md', slot: product_images %}
{% endcapture %}

{% capture product_form %}
  {%- unless product.has_only_default_variant -%}
    {% for option in product.options_with_values %}
      <fieldset>
        {% render 'element.text', as: 'legend', variant: 'body', text: option.name %}

        {% capture option_values %}
          {% for value in option.values %}
            {% if value.available %}
              {%- assign disabled = false -%}
            {% else %}
              {%- assign disabled = true -%}
            {% endif %}

            {%- capture radio_label -%}
              {% if value.swatch %}
                {%- render 'element.swatch', element: 'button', swatch: value.swatch, large: true, selected: value.selected -%}
              {% else %}
                {%- render 'element.button', as: 'span', text: value, inverted: true, selected: value.selected -%}
              {% endif %}
            {%- endcapture -%}

            {%- render 'element.radio',
              id: value.id,
              name: option.name,
              value: value,
              label: radio_label,
              checked: value.selected,
              display_icon: false,
              disabled: disabled
            -%}
          {% endfor %}
        {% endcapture %}

        {% render 'layout.stack', horizontal: true, gap: 'xs', slot: option_values %}
      </fieldset>
    {% endfor %}
  {%- endunless -%}

  {% render 'element.button', text: 'Add to Cart', type: 'submit', full: true %}
{% endcapture %}

{% capture product_form_stack %}
  {% render 'layout.stack', direction: 'column', gap: 'md', slot: product_form %}
{% endcapture %}

{% capture product_details %}
  {% render 'element.text', as: 'h1', variant: 'heading-xl', text: product.title %}
  {% render 'element.price', price: product.price %}

  {% form 'product', product %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {{ product_form_stack }}
  {% endform %}

  {% render 'element.text', variant: 'rte', text: product.description %}
{% endcapture %}

{% capture product_details_stack %}
  {% render 'layout.stack', direction: 'column', gap: 'md', slot: product_details %}
{% endcapture %}

{% capture grid_content %}
  {{ product_images_stack }}
  {{ product_details_stack }}
{% endcapture %}

{% capture grid %}
  {% render 'layout.grid',
    columns_xs: 1,
    columns_md: 2,
    slot: grid_content,
    gap: 'md'
  %}
{% endcapture %}

{% render 'layout.section', slot: grid %}
