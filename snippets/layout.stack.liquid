{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  A versatile layout component that provides flexible stacking of elements in either vertical or horizontal orientation.
  Supports responsive gap sizing, flex wrapping, justification and alignment controls, and can be reversed.
  The component is highly customizable through props while maintaining consistent spacing and layout behavior.

  @param {string} slot - The slot content to wrap
  @param {string} [as] - The HTML element to use for the stack (default: 'div')
  @param {string} [id] - ID attribute
  @param {string} [classlist] - Additional classes to add
  @param {string} [gap] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items, default: 'none'
  @param {string} [gap_xs] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items for xs breakpoint
  @param {string} [gap_sm] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items for sm breakpoint
  @param {string} [gap_md] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items for md breakpoint
  @param {string} [gap_lg] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items for lg breakpoint
  @param {string} [gap_xl] ('none'|'2xs'|'xs'|'sm'|'md'|'lg'|'xl') - Gap size between items for xl breakpoint
  @param {boolean} [horizontal] - Whether the stack should be horizontal (default: false)
  @param {boolean} [reverse] - Whether the stack should be reversed (default: false)
  @param {string} [wrap] - Controls flex wrapping (default: 'wrap'), options: 'wrap', 'nowrap', 'wrap-reverse'
  @param {string} [justify] - Controls how items are positioned along the main axis, options: 'start', 'center', 'end', 'space-around', 'space-between', 'space-evenly'
  @param {string} [align] - Controls how items are aligned along the cross axis, options: 'start', 'center', 'end', 'stretch', 'baseline'
  @param {string} [attributes] - Additional attributes
  @param {string} [style] - Inline styles to apply

  @example
  {% render 'layout.stack', slot: content, horizontal: true, reverse: true, gap: 'xs' %}
{% enddoc %}

{% liquid
  assign slot = slot | default: ''
  assign as = as | default: 'div'
  assign id = id | default: ''
  assign classlist = classlist | default: '' | append: ' layout-stack' | strip
  assign horizontal = horizontal | default: false
  assign reverse = reverse | default: false
  assign wrap = wrap | default: 'wrap'
  assign justify = justify | default: ''
  assign align = align | default: ''
  assign attributes = attributes | default: ''
  assign style = style | default: ''

  assign gap = gap | default: 'none'
  assign gap_xs = gap_xs | default: gap
  assign gap_sm = gap_sm | default: gap
  assign gap_md = gap_md | default: gap
  assign gap_lg = gap_lg | default: gap
  assign gap_xl = gap_xl | default: gap

  if gap != 'none'
    assign style = style | append: '--layout-stack-gap: var(--gap-size-' | append: gap | append: ');'
  endif

  if gap_xs != gap
    assign style = style | append: '--layout-stack-gap--xs: var(--gap-size-' | append: gap_xs | append: ');'
  endif

  if gap_sm != gap
    assign style = style | append: '--layout-stack-gap--sm: var(--gap-size-' | append: gap_sm | append: ');'
  endif

  if gap_md != gap
    assign style = style | append: '--layout-stack-gap--md: var(--gap-size-' | append: gap_md | append: ');'
  endif

  if gap_lg != gap
    assign style = style | append: '--layout-stack-gap--lg: var(--gap-size-' | append: gap_lg | append: ');'
  endif

  if gap_xl != gap
    assign style = style | append: '--layout-stack-gap--xl: var(--gap-size-' | append: gap_xl | append: ');'
  endif

  if justify != blank
    assign style = style | append: ' --layout-stack-justify: ' | append: justify | append: ';'
  endif

  if align != blank
    assign style = style | append: ' --layout-stack-align: ' | append: align | append: ';'
  endif

  if horizontal
    if reverse
      assign style = style | append: ' --layout-stack-direction: row-reverse;'
    else
      assign style = style | append: ' --layout-stack-direction: row;'
    endif
  else
    if reverse
      assign style = style | append: ' --layout-stack-direction: column-reverse;'
    else
      assign style = style | append: ' --layout-stack-direction: column;'
    endif
  endif

  if wrap == 'nowrap' or wrap == 'wrap-reverse'
    assign style = style | append: ' --layout-stack-wrap: ' | append: wrap | append: ';'
  endif
%}

<{{ as }}
  {% if id != blank -%}
    id="{{ id }}"
  {%- endif %}

  class="{{ classlist }}"

  {% if attributes != blank -%}
    {{ attributes }}
  {%- endif %}

  {% if style != blank -%}
    style="{{ style }}"
  {%- endif %}
>
  {{ slot }}
</{{ as }}>

{% render 'style.primitive-tokens' %}

{% stylesheet %}
  :root {
    --layout-stack-gap: var(--gap-size-none);
    --layout-stack-gap--xs: initial;
    --layout-stack-gap--sm: initial;
    --layout-stack-gap--md: initial;
    --layout-stack-gap--lg: initial;
    --layout-stack-gap--xl: initial;

    --layout-stack-row-gap: initial;
    --layout-stack-row-gap--xs: initial;
    --layout-stack-row-gap--sm: initial;
    --layout-stack-row-gap--md: initial;
    --layout-stack-row-gap--lg: initial;
    --layout-stack-row-gap--xl: initial;

    --layout-stack-column-gap: initial;
    --layout-stack-column-gap--xs: initial;
    --layout-stack-column-gap--sm: initial;
    --layout-stack-column-gap--md: initial;
    --layout-stack-column-gap--lg: initial;
    --layout-stack-column-gap--xl: initial;

    --layout-stack-justify: flex-start;
    --layout-stack-align: stretch;
    --layout-stack-margin: 0;
    --layout-stack-direction: column;
    --layout-stack-wrap: wrap;
  }

  .layout-stack {
    /* Layout & Typography */
    --_gap--xs: var(--layout-stack-gap--xs, var(--layout-stack-gap));
    --_gap--sm: var(--layout-stack-gap--sm, var(--_gap--xs));
    --_gap--md: var(--layout-stack-gap--md, var(--_gap--sm));
    --_gap--lg: var(--layout-stack-gap--lg, var(--_gap--md));
    --_gap--xl: var(--layout-stack-gap--xl, var(--_gap--lg));
    --_gap: var(--_gap--xs);

    --_row-gap--xs: var(--layout-stack-row-gap--xs, var(--layout-stack-row-gap, var(--_gap)));
    --_row-gap--sm: var(--layout-stack-row-gap--sm, var(--_row-gap--xs));
    --_row-gap--md: var(--layout-stack-row-gap--md, var(--_row-gap--sm));
    --_row-gap--lg: var(--layout-stack-row-gap--lg, var(--_row-gap--md));
    --_row-gap--xl: var(--layout-stack-row-gap--xl, var(--_row-gap--lg));
    --_row-gap: var(--_row-gap--xs);

    --_column-gap--xs: var(--layout-stack-column-gap--xs, var(--layout-stack-column-gap, var(--_gap)));
    --_column-gap--sm: var(--layout-stack-column-gap--sm, var(--_column-gap--xs));
    --_column-gap--md: var(--layout-stack-column-gap--md, var(--_column-gap--sm));
    --_column-gap--lg: var(--layout-stack-column-gap--lg, var(--_column-gap--md));
    --_column-gap--xl: var(--layout-stack-column-gap--xl, var(--_column-gap--lg));
    --_column-gap: var(--_column-gap--xs);

    --_justify: var(--layout-stack-justify);
    --_align: var(--layout-stack-align);
    --_margin: var(--layout-stack-margin);
    --_direction: var(--layout-stack-direction);
    --_wrap: var(--layout-stack-wrap);

    display: flex;
    flex-direction: var(--_direction);
    row-gap: var(--_row-gap);
    column-gap: var(--_column-gap);
    flex-wrap: var(--_wrap);
    justify-content: var(--_justify);
    align-items: var(--_align);
    margin: var(--_margin);
  }
{% endstylesheet %}

{% style %}
  @media ({% render 'utility.breakpoint', size: 'sm' %}) {
    .layout-stack {
      --_gap-y: var(--_gap-y--sm);
      --_gap-x: var(--_gap-x--sm);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'md' %}) {
    .layout-stack {
      --_gap-y: var(--_gap-y--md);
      --_gap-x: var(--_gap-x--md);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'lg' %}) {
    .layout-stack {
      --_gap-y: var(--_gap-y--lg);
      --_gap-x: var(--_gap-x--lg);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'xl' %}) {
    .layout-stack {
      --_gap-y: var(--_gap-y--xl);
      --_gap-x: var(--_gap-x--xl);
    }
  }
{% endstyle %}
