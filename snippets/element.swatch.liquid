{% doc %}
  Swatch component

  @param {boolean} [large] - Whether the swatch is large
  @param {boolean} [selected] - Whether the swatch is selected
  @param {string} [classlist] - Class list
  @param {string} [style] - Style attribute
  @param {string} [href] - Link (only works if element is 'a')
  @param {boolean} [disabled] - Whether the swatch is disabled

  @example
  {% render 'element.swatch', color: '#000000', selected: true %}
{% enddoc %}

{% liquid
  assign large = large | default: false
  assign selected = selected | default: false
  assign classlist = classlist | default: '' | append: ' swatch' | strip
  assign color = color | default: ''
  assign style = style | default: ''
  assign element = element | default: 'span'
  assign href = href | default: ''
  assign disabled = disabled | default: false

  if element == 'a' and href != blank
    assign classlist = classlist | append: ' swatch--link'
  endif

  if selected
    assign classlist = classlist | append: ' swatch--selected'
  endif

  if large
    assign classlist = classlist | append: ' swatch--large'
  endif

  if disabled
    assign classlist = classlist | append: ' swatch--disabled'
  endif

  if swatch != null
    assign swatch_img = swatch.image | image_url: width: 50
    capture swatch_style
      echo '--swatch-color-background: ' | append: swatch.color | append: ';'
      echo '--swatch-color-background-image: url(' | append: swatch_img | append: ');'
    endcapture
    assign style = style | append: swatch_style
  endif
%}

<{{ element }}
  class="{{ classlist }}"

  {% if element == 'a' and href != blank %}
    href="{{ href }}"
  {% endif %}

  {%- if style != blank -%}
    style="{{ style }}"
  {%- endif -%}
></{{ element }}>

{% stylesheet %}
  .swatch {
    /* Layout */
    --_size-small: var(--swatch-size-small, var(--size-4));
    --_size-large: var(--swatch-size-large, var(--size-8));
    --_size-mobile-ratio: var(--swatch-size-mobile-ratio, 0.875); /* 3.5/4 for small, 6/8 for large (0.75) */
    --_size: var(--_size-small);
    --_radius: var(--swatch-radius, var(--radius-full));
    --_border-width: var(--swatch-border-width, var(--size-0-25));
    --_outline-width: var(--swatch-outline-width, 3px);
    --_line-disabled-width: var(--swatch-line-disabled-width, max(var(--size-0-25), calc(var(--_size) * 0.0625)));

    /* Colors */
    --_color-primary: var(--color-primary);
    --_color-secondary: var(--color-secondary);
    --_color-background: var(--swatch-color-background, var(--_color-primary));
    --_color-background-image: var(--swatch-color-background-image, none);
    --_color-border: var(--swatch-color-border, var(--_color-primary));
    --_color-disabled: var(--swatch-color-disabled, none);
    --_shade-inset: var(--swatch-shade-inset, 16%);
    --_shade-outer: var(--swatch-shade-outer, 0%);
    --_shade-outer-hover: var(--swatch-shade-outer-hover, 20%);
    --_shade-outer-selected: var(--swatch-shade-outer-selected, 100%);

    background: var(--_color-disabled), var(--_color-background-image) center / cover, var(--_color-background);
    width: var(--_size);
    height: var(--_size);
    border-radius: var(--_radius);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--_color-secondary) 100%, transparent),
      0 0 0 var(--_outline-width) color-mix(in srgb, var(--_color-primary) var(--_shade-outer), transparent),
      inset 0 0 0 var(--_border-width) color-mix(in srgb, var(--_color-border) var(--_shade-inset), transparent);
    outline: 0;
    border: none;

    @media only screen and (max-width: 768px) {
      --_size: calc(var(--_size-small) * var(--_size-mobile-ratio));
    }

    &:is(:not(span)) {
      &:hover {
        --_shade-outer: var(--_shade-outer-hover);
      }

      &:focus,
      .swatch--selected,
      input[type='radio']:checked + & {
        --_shade-outer: var(--_shade-outer-selected);
      }
    }
  }

  .swatch--large {
    --_size: var(--_size-large);

    @media only screen and (max-width: 768px) {
      --_size: calc(var(--_size-large) * var(--_size-mobile-ratio));
    }
  }

  .swatch--disabled,
  input[type='radio']:disabled + & {
    --_color-disabled: linear-gradient(
      to bottom right,
      transparent calc(50% - var(--_line-disabled-width)),
      var(--color-secondary) calc(50% - var(--_line-disabled-width)) calc(50% + var(--_line-disabled-width)),
      transparent calc(50% + var(--_line-disabled-width))
    );
  }
{% endstylesheet %}
