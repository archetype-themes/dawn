{% doc %}
  Hot reloads the product when the variant changes.
  @param {string} section - The section ID
  @param {string} product - The product URL
{% enddoc %}

{% capture id %}
  {% render 'utility.id', name: 'product-hot-reload' %}
{% endcapture %}

<product-hot-reload id="{{ id }}" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-uid="{{ uid }}">
  {{ slot }}
</product-hot-reload>

<script type="module" src="{{ 'utility.product-hot-reload.js' |  asset_url }}"></script> 
