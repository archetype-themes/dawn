{% doc %}
  Grid layout component that creates a responsive grid with customizable columns, gaps, and alignment.

  @param {string} slot - The slot content to wrap
  @param {string} classlist - Additional classes to add
  @param {string} style - Inline styles to apply
  @param {string} variant - The variant of the grid (default: 'gap'), options: 'line', 'line-internal', 'gap'
  @param {string|color_scheme} color_scheme - The color scheme of the grid (default: 'none'), options: 'none', '1', '2', '3' or color scheme object
  @param {string} align - The alignment of the grid (default: 'center'), options: 'center', 'start', 'end'
  @param {number} columns - The number of columns in the grid (same for all screens)
  @param {number} columns_xs - The number of columns in the grid for xs screens
  @param {number} columns_sm - The number of columns in the grid for sm screens
  @param {number} columns_md - The number of columns in the grid for md screens
  @param {number} columns_lg - The number of columns in the grid for lg screens
  @param {number} columns_xl - The number of columns in the grid for xl screens
  @param {number} gap - The size of the gap between the grid items (same for all screens)
  @param {number} gap_xs - The size of the gap between the grid items for xs screens
  @param {number} gap_sm - The size of the gap between the grid items for sm screens
  @param {number} gap_md - The size of the gap between the grid items for md screens
  @param {number} gap_lg - The size of the gap between the grid items for lg screens
  @param {number} gap_xl - The size of the gap between the grid items for xl screens
  @param {string} lines - The size of lines in the grid (default: 'sm'), options: 'none', 'xs', 'sm', 'md', 'lg', 'xl'
  @param {number} item_count - The number of items in the grid. If provided, the grid will automatically add filler columns to the end of the grid to fill the remaining space when using the 'line' or 'line-internal' variant.

  @example
  {% render 'layout.grid', slot: grid_items, columns: 3, gap: 'md', align: 'start' %}
{% enddoc %}

{% liquid
  assign classlist = classlist | default: '' | append: ' layout-grid' | strip
  assign style = style | default: ''
  assign align = align | default: 'center'
  assign variant = variant | default: 'gap'
  assign item_count = item_count | default: nil
  assign color_scheme = color_scheme | default: 'none'

  assign columns = columns | default: ''
  assign columns_xs = columns_xs | default: ''
  assign columns_sm = columns_sm | default: ''
  assign columns_md = columns_md | default: ''
  assign columns_lg = columns_lg | default: ''
  assign columns_xl = columns_xl | default: ''

  assign gap = gap | default: 'none'
  assign gap_xs = gap_xs | default: gap
  assign gap_sm = gap_sm | default: gap
  assign gap_md = gap_md | default: gap
  assign gap_lg = gap_lg | default: gap
  assign gap_xl = gap_xl | default: gap

  assign lines = lines | default: 'sm'

  if variant == 'line'
    assign classlist = classlist | append: ' layout-grid--line'
    assign style = style | append: '--layout-grid-line-size: var(--line-size-' | append: lines | append: ');'
  elsif variant == 'line-internal'
    assign classlist = classlist | append: ' layout-grid--line-internal'
    assign style = style | append: '--layout-grid-line-size: var(--line-size-' | append: lines | append: ');'
  elsif variant == 'gap'
    assign classlist = classlist | append: ' layout-grid--gap'
    if gap != 'none'
      assign style = style | append: '--layout-grid-gap: var(--gap-size-' | append: gap | append: ');'
    endif

    if gap_xs != gap
      assign style = style | append: '--layout-grid-gap--xs: var(--gap-size-' | append: gap_xs | append: ');'
    endif

    if gap_sm != gap
      assign style = style | append: '--layout-grid-gap--sm: var(--gap-size-' | append: gap_sm | append: ');'
    endif

    if gap_md != gap
      assign style = style | append: '--layout-grid-gap--md: var(--gap-size-' | append: gap_md | append: ');'
    endif

    if gap_lg != gap
      assign style = style | append: '--layout-grid-gap--lg: var(--gap-size-' | append: gap_lg | append: ');'
    endif

    if gap_xl != gap
      assign style = style | append: '--layout-grid-gap--xl: var(--gap-size-' | append: gap_xl | append: ');'
    endif
  endif

  if columns != blank
    assign style = style | append: '--layout-grid-template-columns: ' | append: columns | append: ';'

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns > 1
      assign leftover = item_count | modulo: columns
      if leftover > 0
        assign filler_columns = columns | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span:' | append: filler_columns
        assign style = style | append: ' --layout-grid--filler-display: block;'
      endif
    endif
  endif

  if columns_xs != blank and columns_xs != columns
    assign style = style | append: '--layout-grid-template-columns--xs: ' | append: columns_xs | append: ';'

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns_xs > 1
      assign leftover = item_count | modulo: columns_xs
      if leftover > 0
        assign filler_columns = columns_xs | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span--xs:' | append: filler_columns
        assign style = style | append: ' --layout-grid--filler-display--xs: block;'
      endif
    endif
  endif

  if columns_sm != blank and columns_sm != columns
    assign style = style | append: '--layout-grid-template-columns--sm: ' | append: columns_sm | append: ';'

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns_sm > 1
      assign leftover = item_count | modulo: columns_sm
      if leftover > 0
        assign filler_columns = columns_sm | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span--sm:' | append: filler_columns | append: ';'
        assign style = style | append: ' --layout-grid--filler-display--sm: block;'
      endif
    endif
  endif

  if columns_md != blank and columns_md != columns
    assign style = style | append: '--layout-grid-template-columns--md: ' | append: columns_md | append: ';' 

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns_md > 1
      assign leftover = item_count | modulo: columns_md
      if leftover > 0
        assign filler_columns = columns_md | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span--md:' | append: filler_columns | append: ';'
        assign style = style | append: ' --layout-grid--filler-display--md: block;'
      endif
    endif
  endif

  if columns_lg != blank and columns_lg != columns
    assign style = style | append: '--layout-grid-template-columns--lg: ' | append: columns_lg | append: ';'

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns_lg > 1
      assign leftover = item_count | modulo: columns_lg
      if leftover > 0
        assign filler_columns = columns_lg | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span--lg:' | append: filler_columns | append: ';'
        assign style = style | append: ' --layout-grid--filler-display--lg: block;'
      endif
    endif
  endif

  if columns_xl != blank and columns_xl != columns
    assign style = style | append: '--layout-grid-template-columns--xl: ' | append: columns_xl | append: ';'

    # Add filler columns if the grid is a line grid and there are more items than columns
    if item_count != nil and variant contains 'line' and columns_xl > 1
      assign leftover = item_count | modulo: columns_xl
      if leftover > 0
        assign filler_columns = columns_xl | minus: leftover
        assign style = style | append: ' --layout-grid--filler-span--xl:' | append: filler_columns | append: ';'
        assign style = style | append: ' --layout-grid--filler-display--xl: block;'
      endif
    endif
  endif

  if align != 'center'
    assign style = style | append: '--layout-grid-align-items: ' | append: align | append: ';'
  endif

  if color_scheme != 'none' 
    assign classlist = classlist | append: ' color-scheme-' | append: color_scheme | strip
  endif
%}

{% if variant == 'line' or variant == 'line-internal' %}
  {% render 'layout.grid--line' %}
{% elsif variant == 'gap' %}
  {% render 'layout.grid--gap' %}
{% endif %}

<div class="{{ classlist }}" style="{{ style }}">
  {{ slot }}
</div>

{% stylesheet %}
  .layout-grid {
    --_columns--xs: var(--layout-grid-template-columns--xs, var(--layout-grid-template-columns, 3));
    --_columns--sm: var(--layout-grid-template-columns--sm, var(--_columns--xs));
    --_columns--md: var(--layout-grid-template-columns--md, var(--_columns--sm));
    --_columns--lg: var(--layout-grid-template-columns--lg, var(--_columns--md));
    --_columns--xl: var(--layout-grid-template-columns--xl, var(--_columns--lg));
    --_columns: var(--_columns--xs);

    --_align-items: var(--layout-grid-align-items, start);

    display: grid;
    align-items: var(--_align-items);
    grid-template-columns: repeat(var(--_columns), minmax(0, 1fr));
  }
{% endstylesheet %}

{% style %}
  @media ({% render 'utility.breakpoint', size: 'sm' %}) {
    .layout-grid {
      --_columns: var(--_columns--sm);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'md' %}) {
    .layout-grid {
      --_columns: var(--_columns--md);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'lg' %}) {
    .layout-grid {
      --_columns: var(--_columns--lg);
    }
  }

  @media ({% render 'utility.breakpoint', size: 'xl' %}) {
    .layout-grid {
      --_columns: var(--_columns--xl);
    }
  }
{% endstyle %}





