{% doc %}
  Radio component

  @param {string} [id] - The ID of the radio field
  @param {number} [index] - The index of the radio field (default: 1)
  @param {string} name - The name of the radio field
  @param {string} [label] - The label for the radio field
  @param {string} value - The value of the radio field
  @param {string} [attributes] - Additional attributes for the radio field
  @param {string} [style] - Additional styles for the radio field
  @param {string} [classlist] - Additional classes for the radio field
  @param {boolean} [disabled] - Whether the radio field should be disabled (default: false)
  @param {boolean} [checked] - Whether the radio field should be checked (default: false)
  @param {boolean} [display_icon] - Whether the icon should be displayed (default: true)

  @example
  {% render 'element.radio', name: 'size', label: 'Small', value: 'small' %}
{% enddoc %}

{%- liquid
  assign index = index | default: 1
  assign name = name | default: ''
  assign label = label | default: ''
  assign value = value | default: ''
  assign attributes = attributes | default: ''
  assign style = style | default: ''
  assign classlist = classlist | default: '' | append: ' radio' | strip
  assign checked = checked | default: false
  assign display_icon = display_icon | default: true, allow_false: true

  capture id_default
    render 'utility.id', name: name, index: index
  endcapture
  assign id = id | default: id_default
-%}

<label
  class="{{ classlist }}"
  for="{{ id }}"
  {% if style != blank -%}
    style="{{ style }}"
  {%- endif %}
>
  <input
    type="radio"
    id="{{ id }}"
    {% if name != blank -%}
      name="{{ name }}"
    {%- endif %}

    {% if attributes != blank -%}
      {{ attributes }}
    {%- endif %}

    {% if checked -%}
      checked
    {%- endif %}

    {% if disabled -%}
      disabled
    {%- endif %}

    {% if value != blank -%}
      value="{{ value }}"
    {%- endif %}
  >
  {%- if display_icon -%}
    <span class="radio__icon"></span>
  {%- endif -%}

  {%- if label != blank -%}
    {{ label }}
  {%- endif -%}
</label>

{% stylesheet %}
  :root {
    --radio-color-primary: #000;
    --radio-color-secondary: #FFF;
  }

  .radio {
    /* Layout & Typography */
    --_size: var(--radio-size, var(--size-5));
    --_dot-size: var(--radio-dot-size, var(--size-2-5));
    --_dot-opacity: var(--radio-dot-opacity, 0);
    --_radius: var(--radio-radius, 50%);
    --_gap: var(--radio-gap, var(--size-2));
    --_outline-width: var(--radio-outline-width, 1px);
    --_outline-width-active: var(--radius-outline-width-active, 2px);
    --_font-family: var(--radio-font-family, var(--body-font-family), var(--body-font-family-fallback));
    --_font-size: var(--radio-font-size, var(--body-md-font-size));
    --_letter-spacing: var(--radio-letter-spacing, var(--body-letter-spacing));
    --_line-height: var(--radio-line-height, var(--body-line-height));
    --_font-weight: var(--radio-font-weight, normal);

    /* Colors */
    --_color-primary: var(--radio-color-primary, var(--color-primary));
    --_color-secondary: var(--radio-color-secondary, var(--color-secondary));
    --_color-active: var(--radio-color-active, var(--color-focus));
    --_color-background: var(--_color-secondary);
    --_color-text: var(--_color-primary);
    --_color-shadow: var(
      --radio-shadow-color,
      color-mix(in srgb, var(--_color-primary) var(--_outline-shade), var(--_color-secondary))
    );
    --_outline-shade: var(--radio-outline-shade, 12%);
    --_shadow-h-offset: var(--radio-shadow-horizontal-offset, 0);
    --_shadow-v-offset: var(--radio-shadow-vertical-offset, 0);
    --_shadow-blur: var(--radio-shadow-blur-radius, 0);
    --_shadow-spread: var(--radio-shadow-spread-radius, var(--_outline-width));

    @media (max-width: 768px) {
      --_size: var(--radio-size, var(--size-4));
      --_dot-size: var(--radio-dot-size, var(--size-2));
    }

    position: relative;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--_gap);
    color: var(--_color-text);
    font-family: var(--_font-family);
    font-size: var(--_font-size);
    letter-spacing: var(--_letter-spacing);
    line-height: var(--_line-height);
    font-weight: var(--_font-weight);

    input[type='radio'] {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    &:hover {
      --_color-background: color-mix(in srgb, var(--_color-primary) 4%, var(--_color-secondary));
    }

    &:has(input[type='radio']:checked) {
      --_dot-opacity: 1;
      --_color-background: var(--_color-primary);
      --_color-shadow: var(--_color-primary);
    }

    &:has(input[type='radio']:focus-visible) {
      --_color-shadow: var(--_color-active);
      --_outline-width: var(--_outline-width-active);
    }

    &:has(input[type='radio']:disabled) {
      --_color-background: color-mix(in srgb, var(--_color-primary) 8%, var(--_color-secondary));
      --_color-shadow: color-mix(in srgb, var(--_color-primary) 8%, var(--_color-secondary));
    }
  }

  .radio__icon {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: var(--_size);
    height: var(--_size);
    border-radius: var(--_radius);
    box-shadow: var(--_shadow-h-offset) var(--_shadow-v-offset) var(--_shadow-blur) var(--_shadow-spread)
      var(--_color-shadow);
    background-color: var(--_color-background);

    &::before {
      content: '';
      width: var(--_dot-size);
      height: var(--_dot-size);
      background-color: var(--_color-secondary);
      border-radius: 50%;
      opacity: var(--_dot-opacity);
    }
  }
{% endstylesheet %}
